<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the C# app. Run from the project folder: make test (or dotnet test tests/app.Tests) -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\app\mouSEE.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- the app's folders, the same as in app/mouSEE.csproj -->
  <ItemGroup>
    <Using Include="app.Tracker" />
    <Using Include="app.Calibration.EyeCheck" />
    <Using Include="app.Calibration.GazeGrid" />
    <Using Include="app.Calibration.Saving" />
    <Using Include="app.Calibration.Accuracy" />
    <Using Include="app.Bubble" />
    <Using Include="app.Bubble.HeadModes" />
    <Using Include="app.Input" />
    <Using Include="app.LookToAnswer" />
    <Using Include="app.UI" />
    <Using Include="app.Settings" />
  </ItemGroup>

</Project>
