<Window x:Class="app.Bubble.RecenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:app.UI"
        Title="mouSEE re-center"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="#101010"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <!-- a dot in the middle of the screen, looked at for a moment (RecenterWindow.xaml.cs) -->
    <Grid>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="90" Height="90">
            <Ellipse Stroke="#3A3A3A" StrokeThickness="4" />
            <Ellipse x:Name="Ring" Stroke="#F7D060" StrokeThickness="4" StrokeDashArray="0,100" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="-90" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <!-- the dot itself, the same middle dot as everywhere else (MiddleDot.xaml) -->
            <ui:MiddleDot x:Name="Middle" />
        </Grid>
        <TextBlock x:Name="MessageText" Text="Look at the dot" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="0,190,0,0" Foreground="White" FontSize="26" FontWeight="SemiBold" TextAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="800" />
        <TextBlock Text="Esc to skip" Foreground="#5A5A5A" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,12" />
    </Grid>
</Window>
