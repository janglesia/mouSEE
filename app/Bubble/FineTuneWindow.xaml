<Window x:Class="app.Bubble.FineTuneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:look="clr-namespace:app.LookToAnswer"
        xmlns:ui="clr-namespace:app.UI"
        Title="mouSEE fine-tune"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="#101010"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <Grid x:Name="Root">
        <!-- the dot to look at, then every dot as a ring with the bubble live: grey without the fine-tune, yellow with it -->
        <Canvas x:Name="Board" IsHitTestVisible="False">
            <Ellipse x:Name="Dot" Width="26" Height="26" Fill="#F7D060" Visibility="Collapsed" />
            <Ellipse x:Name="BeforeBubble" Width="34" Height="34" Fill="#40FFFFFF" Stroke="#A0A0A0" StrokeThickness="1.5" Visibility="Collapsed" />
            <Ellipse x:Name="AfterBubble" Width="34" Height="34" Fill="#55F7D060" Stroke="#F7D060" StrokeThickness="2" Visibility="Collapsed" />
        </Canvas>

        <StackPanel x:Name="IntroPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640">
            <TextBlock Text="Fine-tune" Foreground="White" FontSize="34" FontWeight="SemiBold" />
            <TextBlock Foreground="#C0C0C0" FontSize="16" TextWrapping="Wrap" Margin="0,12,0,0"
                       Text="The last adjustments: 20 dots show up around the screen, look at each one until the next shows up. Sit like you normally do. It takes about 50 seconds. Then the bubble moves with the fine-tune, and you choose whether to keep it." />
            <TextBlock x:Name="CalibrationText" Foreground="#8A8A8A" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                <Button Content="Begin" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="BeginButton_Click" />
                <Button Content="Close" Style="{StaticResource DarkButton}" Click="CloseButton_Click" />
            </StackPanel>
        </StackPanel>

        <Border x:Name="ResultPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                Background="#E0101010" CornerRadius="6" Padding="20,14" MaxWidth="1000">
            <StackPanel>
                <TextBlock x:Name="ResultTitle" Text="Try it out" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="ResultText" Foreground="#D0D0D0" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock x:Name="LegendText" Foreground="#A0A0A0" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Look at the rings. Yellow bubble: with the fine-tune. Grey bubble: how it is now." />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="KeepButton" Content="Keep it" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="KeepButton_Click" />
                    <Button x:Name="AgainButton" Content="Try again" Style="{StaticResource DarkButton}" Margin="0,0,10,0" Click="BeginButton_Click" />
                    <Button Content="Discard" Style="{StaticResource DarkButton}" Click="CloseButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ProgressText" Foreground="#5A5A5A" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,24" />

        <!-- whenever you're asked to look at the middle of the screen (MiddleDot.xaml) -->
        <ui:MiddleDot x:Name="Middle" />

        <look:ChoicePrompt x:Name="Choice" VerticalAlignment="Bottom" Margin="32,0,32,48" Visibility="Collapsed" />

        <TextBlock Text="Esc to close" Foreground="#5A5A5A" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,12" />
    </Grid>
</Window>
