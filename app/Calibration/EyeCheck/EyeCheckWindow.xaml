<Window x:Class="app.Calibration.EyeCheck.EyeCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:look="clr-namespace:app.LookToAnswer"
        xmlns:ui="clr-namespace:app.UI"
        Title="mouSEE eye check"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="#101010"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <Grid x:Name="Root">
        <!-- before starting -->
        <StackPanel x:Name="IntroPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640">
            <TextBlock Text="Eye check" Foreground="White" FontSize="34" FontWeight="SemiBold" />
            <TextBlock Foreground="#C0C0C0" FontSize="16" TextWrapping="Wrap" Margin="0,12,0,0"
                       Text="The last part: mouSEE learns what your eyes look like closed. You close both eyes a few times, once with your head tilted up and once down. It takes under a minute. Every instruction is read out loud, so turn your sound on. Keep your eyes closed until you hear the sound, then the next one starts." />
            <TextBlock Foreground="#C0C0C0" FontSize="16" TextWrapping="Wrap" Margin="0,12,0,0"
                       Text="Sit how you normally would, in the light you normally use." />
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Ellipse x:Name="FaceDot" Width="12" Height="12" Fill="#6C8179" VerticalAlignment="Center" />
                <TextBlock x:Name="FaceText" Text="Waiting for the camera..." Foreground="#C0C0C0" FontSize="14" Margin="10,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                <Button x:Name="BeginButton" Content="Begin" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="BeginButton_Click" />
                <Button Content="Cancel" Style="{StaticResource DarkButton}" Click="CancelButton_Click" />
            </StackPanel>
        </StackPanel>

        <!-- while it runs -->
        <StackPanel x:Name="RunPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="900" Visibility="Collapsed">
            <TextBlock x:Name="StepText" Foreground="#8A8A8A" FontSize="16" HorizontalAlignment="Center" />
            <TextBlock x:Name="InstructionText" Foreground="White" FontSize="40" FontWeight="SemiBold" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="0,12,0,0" />
            <TextBlock x:Name="HintText" Foreground="#E0A458" FontSize="20" TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,0" />
            <!-- live while a step records: what's wrong (amber), or green "Good" when the eyes and head are right (SetLive) -->
            <TextBlock x:Name="LiveText" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" />
            <Border Background="#2B2B2B" Height="6" CornerRadius="3" Width="420" Margin="0,28,0,0">
                <Border x:Name="ProgressFill" Background="#F7D060" CornerRadius="3" HorizontalAlignment="Left" Width="0" />
            </Border>
        </StackPanel>

        <!-- at the end -->
        <StackPanel x:Name="ResultPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="760" Visibility="Collapsed">
            <TextBlock x:Name="ResultTitle" Foreground="White" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="ResultSubtitle" Foreground="#C0C0C0" FontSize="16" TextWrapping="Wrap" Margin="0,10,0,0" />
            <ItemsControl x:Name="NotesList" Margin="0,18,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#D0D0D0" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Margin="0,18,0,0">
                <Button x:Name="ContinueButton" Content="Continue" Style="{StaticResource PrimaryButton}" Margin="0,0,10,10" Click="ContinueButton_Click" />
                <Button x:Name="RedoButton" Content="Do it again" Style="{StaticResource DarkButton}" Margin="0,0,10,10" Click="RedoButton_Click" />
                <Button x:Name="DefaultsButton" Content="Keep default values" Style="{StaticResource DarkButton}" Margin="0,0,10,10" Click="DefaultsButton_Click" />
                <Button Content="Cancel" Style="{StaticResource DarkButton}" Margin="0,0,10,10" Click="CancelButton_Click" />
            </WrapPanel>
        </StackPanel>

        <!-- whenever you're asked to look at the middle of the screen (MiddleDot.xaml) -->
        <ui:MiddleDot x:Name="Middle" />

        <!-- yes / no by looking, for the intro and the result. at the edges so the eyes have to really look that way -->
        <look:ChoicePrompt x:Name="Choice" VerticalAlignment="Bottom" Margin="32,0,32,48" Visibility="Collapsed" />

        <TextBlock Text="Esc to cancel" Foreground="#5A5A5A" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,12" />
    </Grid>
</Window>
