<Window x:Class="app.UI.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="mouSEE Calibration"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="Black"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- Cheese yellow. Change this one brush to re-theme the whole wizard background -->
        <SolidColorBrush x:Key="WizardBackground" Color="#F7D060" />

        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#C65D43" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="22,11" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#294A42" />
            <Setter Property="Foreground" Value="#D0DED9" />
        </Style>
        <!-- for the black results card and test bar -->
        <Style x:Key="DarkButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#2B2B2B" />
            <Setter Property="Foreground" Value="#E0E0E0" />
        </Style>

        <!-- one stat tile on the results card -->
        <Style x:Key="TileBorder" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#1C1C1C" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style x:Key="TileLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="TileValue" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="TileDetail" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#BDBDBD" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="{StaticResource WizardBackground}">

        <!-- ================= Target layer (shown while the sequence runs) ================= -->
        <Canvas x:Name="TargetLayer" Visibility="Collapsed" IsHitTestVisible="False">
            <Grid x:Name="TargetVisual" Width="120" Height="120" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="TargetScale" ScaleX="1" ScaleY="1" />
                </Grid.RenderTransform>

                <!-- faint full ring + capture progress ring on top of it -->
                <Ellipse Width="120" Height="120" Stroke="#E0B63C" StrokeThickness="4" />
                <Ellipse x:Name="CaptureRing" Width="120" Height="120" Stroke="#1F5F4A" StrokeThickness="4"
                         StrokeDashArray="0,100" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90" />
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Image x:Name="TargetLogo" Width="84" Height="84" Source="/assets/mouSEE-logo.png"
                       Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- exact point to look at; delete this element if you don't want it -->
                <Ellipse x:Name="CenterDot" Width="8" Height="8" Fill="White" Stroke="#193630" StrokeThickness="2"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Canvas>

        <!-- subtle progress readout while running -->
        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Bottom"
                    HorizontalAlignment="Center" Margin="0,0,0,28">
            <TextBlock x:Name="ProgressText" Foreground="#5C4A10" FontSize="13" HorizontalAlignment="Center" />
            <TextBlock x:Name="BackendStatusText" Foreground="#6B5A1E" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
            <TextBlock x:Name="TrackingWarningText" Foreground="#8A2E0E" FontSize="14" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>

        <TextBlock x:Name="EscHint" Text="Esc to cancel" Foreground="#7A6420" FontSize="12"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,24,0" />

        <!-- ================= Intro ================= -->
        <Border x:Name="IntroPanel" Width="560" Background="Black" BorderBrush="#2A2A2A" BorderThickness="1"
                CornerRadius="8" Padding="36" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Rectangle Width="112" Height="112" Fill="White" HorizontalAlignment="Center">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="/assets/mouSEE-logo.png" Stretch="Uniform" />
                    </Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock Text="Calibration" Foreground="White" FontSize="28" FontWeight="SemiBold" Margin="0,18,0,0" />
                <TextBlock TextWrapping="Wrap" Foreground="#BDBDBD" FontSize="14" Margin="0,10,0,0"
                           Text="The mouSEE logo will appear in 9 places across your screen. Look at the white dot in the middle of the logo and keep looking at it until it moves." />

                <StackPanel Margin="0,22,0,0">
                    <TextBlock Text="Sit at a comfortable distance with your face centered in the camera" Foreground="#E0E0E0" FontSize="13" TextWrapping="Wrap" />
                    <TextBlock Text="Keep your head still. Move only your eyes" Foreground="#E0E0E0" FontSize="13" Margin="0,8,0,0" />
                    <TextBlock Text="Try not to blink while the ring is filling" Foreground="#E0E0E0" FontSize="13" Margin="0,8,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                    <Ellipse x:Name="FaceStatusDot" Width="10" Height="10" Fill="#6C8179" VerticalAlignment="Center" />
                    <TextBlock x:Name="FaceStatusText" Text="Waiting for tracker..." Foreground="#E0E0E0" FontSize="13" Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                    <Button x:Name="BeginButton" Content="Begin" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="BeginButton_Click" />
                    <Button Content="Cancel" Style="{StaticResource DarkButton}" Click="CloseButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ================= Results ================= -->
        <Border x:Name="ResultPanel" Visibility="Collapsed" Width="640" Background="Black" BorderBrush="#2A2A2A"
                BorderThickness="1" CornerRadius="8" Padding="36" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Rectangle Width="112" Height="112" Fill="White" HorizontalAlignment="Center">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="/assets/mouSEE-logo.png" Stretch="Uniform" />
                    </Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock x:Name="ResultTitle" Foreground="White" FontSize="28" FontWeight="SemiBold" Margin="0,16,0,0" />
                <TextBlock x:Name="ResultSubtitle" Foreground="#BDBDBD" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0" />

                <UniformGrid Columns="2" Margin="0,24,-8,0">
                    <Border Style="{StaticResource TileBorder}">
                        <StackPanel>
                            <TextBlock Text="ESTIMATED ACCURACY" Style="{StaticResource TileLabel}" />
                            <TextBlock x:Name="AccuracyValue" Style="{StaticResource TileValue}" />
                            <TextBlock x:Name="AccuracyDetail" Style="{StaticResource TileDetail}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TileBorder}">
                        <StackPanel>
                            <TextBlock Text="TRACKING STATUS" Style="{StaticResource TileLabel}" />
                            <TextBlock x:Name="TrackingValue" Style="{StaticResource TileValue}" />
                            <TextBlock x:Name="TrackingDetail" Style="{StaticResource TileDetail}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TileBorder}">
                        <StackPanel>
                            <TextBlock Text="TARGETS COMPLETED" Style="{StaticResource TileLabel}" />
                            <TextBlock x:Name="TargetsValue" Style="{StaticResource TileValue}" />
                            <TextBlock x:Name="TargetsDetail" Style="{StaticResource TileDetail}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TileBorder}">
                        <StackPanel>
                            <TextBlock Text="CALIBRATION QUALITY" Style="{StaticResource TileLabel}" />
                            <TextBlock x:Name="QualityValue" Style="{StaticResource TileValue}" />
                            <TextBlock x:Name="QualityDetail" Style="{StaticResource TileDetail}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Text="WHAT TO DO NEXT" Foreground="#9A9A9A" FontSize="10" FontWeight="Bold" Margin="0,14,0,0" />
                <TextBlock x:Name="NextStepText" Foreground="#E0E0E0" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                    <Button x:Name="AcceptButton" Content="Accept calibration" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="AcceptButton_Click" />
                    <Button Content="Try again" Style="{StaticResource DarkButton}" Margin="0,0,10,0" Click="TryAgainButton_Click" />
                    <Button x:Name="TestButton" Content="Test tracking" Style="{StaticResource DarkButton}" Visibility="Collapsed" Click="TestButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ================= Visual test (only reachable when a GazePredictor is set) ================= -->
        <Canvas x:Name="TestLayer" Visibility="Collapsed" IsHitTestVisible="False">
            <Ellipse x:Name="GazeDot" Width="30" Height="30" Fill="#C65D43" Stroke="White" StrokeThickness="3"
                     Opacity="0.92" Panel.ZIndex="10" />
        </Canvas>
        <Border x:Name="TestBar" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,36" Background="Black" CornerRadius="8" Padding="24,16">
            <StackPanel>
                <TextBlock Text="Look at each ring. The red dot shows where the tracker thinks you're looking."
                           Foreground="#E0E0E0" FontSize="14" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Button Content="Accept calibration" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="AcceptButton_Click" />
                    <Button Content="Try again" Style="{StaticResource DarkButton}" Margin="0,0,10,0" Click="TryAgainButton_Click" />
                    <Button Content="Back to results" Style="{StaticResource DarkButton}" Click="BackToResultButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
