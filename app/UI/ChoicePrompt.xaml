<UserControl x:Class="app.UI.ChoicePrompt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <!-- No on the left, Yes on the right. Looking at one fills its bar, full after LookChoice.HoldMs -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border x:Name="NoSide" Grid.Column="0" Background="#2B2B2B" CornerRadius="6" Padding="18,12" MinWidth="170">
            <StackPanel>
                <TextBlock Text="← No" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="NoCaption" Foreground="#C0C0C0" FontSize="13" TextWrapping="Wrap" MaxWidth="220" Margin="0,2,0,8" />
                <Border Background="#444444" Height="6" CornerRadius="3">
                    <Border x:Name="NoFill" Background="#E06C6C" CornerRadius="3" HorizontalAlignment="Left" Width="0" />
                </Border>
            </StackPanel>
        </Border>

        <TextBlock x:Name="HintText" Grid.Column="1" Foreground="#8A8A8A" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                   VerticalAlignment="Center" Margin="16,0" />

        <Border x:Name="YesSide" Grid.Column="2" Background="#2B2B2B" CornerRadius="6" Padding="18,12" MinWidth="170">
            <StackPanel>
                <TextBlock Text="Yes →" Foreground="White" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock x:Name="YesCaption" Foreground="#C0C0C0" FontSize="13" TextWrapping="Wrap" MaxWidth="220" Margin="0,2,0,8"
                           TextAlignment="Right" HorizontalAlignment="Right" />
                <Border Background="#444444" Height="6" CornerRadius="3">
                    <Border x:Name="YesFill" Background="#6FCF97" CornerRadius="3" HorizontalAlignment="Left" Width="0" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
