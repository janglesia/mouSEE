<Window x:Class="app.UI.MainMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mousee Main Menu"
        Width="1100"
        Height="650"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#141414">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Settings button: top center -->
        <Button Grid.Row="0"
                Grid.Column="1"
                Content="Settings"
                Style="{StaticResource PrimaryButton}"
                FontSize="28"
                Width="300"
                Height="65"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"/>

        <!-- Return button: middle left -->
        <Button Grid.Row="1"
                Grid.Column="0"
                Content="Return"
                Style="{StaticResource PrimaryButton}"
                FontSize="28"
                Width="190"
                Height="110"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Click="ReturnButton_Click"/>

        <!-- Logo and title: center -->
        <StackPanel Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="MouSEE"
                       FontSize="55"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="White"/>

            <TextBlock Text="Main Menu"
                       FontSize="36"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="White"/>
        </StackPanel>

        <!-- Calibration button: middle right -->
        <Button Grid.Row="1"
                Grid.Column="2"
                Content="Calibrate"
                Style="{StaticResource PrimaryButton}"
                FontSize="28"
                Width="190"
                Height="110"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"/>

        <!-- Quit button: bottom center -->
        <Button Grid.Row="2"
                Grid.Column="1"
                Content="Quit"
                Style="{StaticResource PrimaryButton}"
                FontSize="28"
                Width="300"
                Height="65"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"/>

    </Grid>
</Window>