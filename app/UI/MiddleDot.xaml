<UserControl x:Class="app.UI.MiddleDot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Center" VerticalAlignment="Center"
             IsHitTestVisible="False" Visibility="Collapsed">
    <!-- a dot in the exact middle of the screen, whenever you're asked to look at the middle. colour from UiColors.MiddleDot,
         set in code from whatever background is behind it. the halo is the background, so it reads over text too -->
    <Grid Width="52" Height="52">
        <Ellipse x:Name="Halo" Width="52" Height="52" Opacity="0.85" />
        <Ellipse x:Name="Ring" Width="40" Height="40" StrokeThickness="3" />
        <Ellipse x:Name="Center" Width="14" Height="14" />
    </Grid>
</UserControl>
