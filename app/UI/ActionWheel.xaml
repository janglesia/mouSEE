<UserControl x:Class="app.UI.ActionWheel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320" Height="320"
             IsHitTestVisible="False"
             Visibility="Collapsed">
    <Grid>
        <!-- Outer dark backdrop circle -->
        <Ellipse Width="310" Height="310" Fill="#80000000" />
        
        <!-- Slices and radial dwell indicator -->
        <Canvas x:Name="WheelCanvas" Width="320" Height="320" />

        <!-- Center Hub matching mockup: pill capsule with green accent -->
        <Border Width="96" Height="58"
                CornerRadius="29"
                Background="#E61A1A1A"
                BorderBrush="#50C878"
                BorderThickness="1.5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="◉"
                           Foreground="#50C878"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,-2,0,0" />
                <TextBlock x:Name="CenterTitle"
                           Text="mouSEE"
                           Foreground="White"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="CenterSubtitle"
                           Text="Center"
                           Foreground="#50C878"
                           FontFamily="Segoe UI"
                           FontSize="9"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>