<Window x:Class="app.UI.CalibrationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:app.UI"
        Title="mouSEE calibrations"
        Width="600"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#141414"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" Text="Calibrations" Foreground="White" FontSize="22" FontWeight="SemiBold" />
        <TextBlock x:Name="IntroText" Foreground="#B0B0B0" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,16" />

        <!-- saved calibrations, the one in use first -->
        <ListBox x:Name="ProfileList"
                 MaxHeight="280"
                 Background="#1C1C1C"
                 BorderThickness="0"
                 Padding="4"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="ProfileList_SelectionChanged"
                 MouseDoubleClick="ProfileList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" Foreground="#8A8A8A" FontSize="12" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#6FCF97" CornerRadius="3" Padding="6,2" VerticalAlignment="Center"
                                Visibility="{Binding InUseVisibility}">
                            <TextBlock Text="IN USE" Foreground="#141414" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <WrapPanel Margin="0,16,0,0">
            <Button x:Name="NewButton" Content="New calibration" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Click="NewButton_Click" />
            <Button x:Name="UseButton" Content="Use this one" Style="{StaticResource DarkButton}" Margin="0,0,8,8" Click="UseButton_Click" />
            <Button x:Name="DeleteButton" Content="Delete" Style="{StaticResource DarkButton}" Margin="0,0,8,8" Click="DeleteButton_Click" />
            <Button x:Name="CloseButton" Content="Close" Style="{StaticResource DarkButton}" Margin="0,0,8,8" Click="CloseButton_Click" />
        </WrapPanel>

        <!-- the startup question can be answered by looking: right for yes (calibrate), left for no -->
        <local:ChoicePrompt x:Name="Choice" Margin="0,8,0,8" Visibility="Collapsed" />

        <CheckBox x:Name="AskCheckBox"
                  Content="Ask me to calibrate when mouSEE starts without a calibration"
                  Foreground="#B0B0B0"
                  FontSize="12"
                  Margin="0,8,0,0"
                  Click="AskCheckBox_Click" />
    </StackPanel>
</Window>
